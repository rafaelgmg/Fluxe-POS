# Copy this file to .env.local and fill in the values
# Never commit .env.local to git

VITE_ADMIN_PASSWORD=your_admin_password_here

# ── Supabase (Phase 1+) ───────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: organization UUID (auto-detected from DB if blank)
# To find: run in Supabase SQL Editor: SELECT id FROM organizations LIMIT 1;
VITE_SUPABASE_ORG_ID=

# ── Invoice seed (REQUIRED — set differently for each kiosk) ─────────────────
# Prevents invoice number collisions between kiosks.
# Kiosk A: 60000  →  invoices 60001, 60002, ...
# Kiosk B: 70000  →  invoices 70001, 70002, ...
# Rule: each kiosk must use a range that does NOT overlap with other kiosks.
# Gap between seeds must be > total expected daily sales × operating days.
VITE_INVOICE_SEED=60000

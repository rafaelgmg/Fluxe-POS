# ─────────────────────────────────────────────
#  Perfume Passage — Server Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to git
# ─────────────────────────────────────────────

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Twilio ──────────────────────────────────
# Get these at: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number (SMS) — format: +17025550000
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# WhatsApp sender (Twilio Sandbox or approved number)
# Format: whatsapp:+14155238886  (sandbox number)
# Or your approved WA number: whatsapp:+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── SMS Safety Controls ──────────────────────
#
# TEST MODE — when set, ALL outbound SMS go to this number instead of the real recipient.
# Use your own cell number here while testing templates.
# REMOVE or leave blank to send to real customers.
# SMS_TEST_NUMBER=+17025550000
#
# AUTOMATION — controls whether the hourly scheduler auto-fires pending messages.
# Keep false until you are ready to go live with automated sequences.
# Manual sends via the CRM are NOT affected by this flag.
SMS_AUTOMATION_ENABLED=false
#
# RATE LIMIT — max SMS per customer per 24-hour window (manual + auto combined).
# Prevents accidental duplicate sends. Recommended: 3.
SMS_RATE_LIMIT_PER_DAY=3

# ── Supabase (server-side — SERVICE KEY, never expose to frontend) ───────────
# Get service_role key: Supabase dashboard → Settings → API → service_role (secret)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Organization UUID — used by the Twilio webhook to find customers by phone
ORG_ID=your-org-uuid-here

# ── Business ────────────────────────────────
BUSINESS_NAME=Perfume Passage
LOCATION_NAME=Miracle Mall 01
